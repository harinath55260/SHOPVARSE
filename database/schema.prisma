// =============================================================================
// ShopVerse 3D V2 — Enterprise PostgreSQL Schema Definition (Prisma)
// Multi-Vendor Spatial & AI-Driven E-Commerce Architecture
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  SUPPORT_AGENT
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum Model3DType {
  PHONE
  LAPTOP
  HEADPHONES
  WATCH
  SHOES
  CONTROLLER
  CUSTOM
}

enum OrderStatus {
  ORDER_PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  COD
  WALLET
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FLAT
}

enum RewardTier {
  SILVER
  GOLD
  PLATINUM
}

enum RewardTxType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

enum TicketCategory {
  ORDER_STATUS
  RETURN_REFUND
  THREE_D_AR_FEATURE
  PAYMENT_ISSUE
  TECHNICAL_SUPPORT
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReplySender {
  USER
  SUPPORT
  AI
}

enum NotificationType {
  ORDER
  DEAL
  PRICE_DROP
  STOCK
  SYSTEM
}

// -----------------------------------------------------------------------------
// USER & IDENTITY
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  avatar        String?
  provider      String?   @default("email")
  providerId    String?
  isBlocked     Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  supportTickets  SupportTicket[]
  sellerProducts  Product[]        @relation("SellerProducts")
  rewardAccount   UserReward?
  notifications   Notification[]
  auditLogs       AuditLog[]       @relation("AdminAuditLogs")

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Address {
  id          String      @id @default(cuid())
  userId      String
  fullName    String
  phone       String
  flat        String
  street      String
  landmark    String?
  city        String
  state       String
  pincode     String
  country     String      @default("India")
  latitude    Float?
  longitude   Float?
  isDefault   Boolean     @default(false)
  addressType AddressType @default(HOME)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relationships
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([pincode])
  @@map("addresses")
}

// -----------------------------------------------------------------------------
// CATALOG: CATEGORIES & PRODUCTS
// -----------------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  tagline     String?
  description String?
  iconName    String     @default("Sparkles")
  imageUrl    String?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Hierarchical relations
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("SubCategories")

  // Products
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id                 String      @id @default(cuid())
  name               String
  slug               String      @unique
  description        String      @db.Text
  brand              String
  categoryId         String
  price              Decimal     @db.Decimal(12, 2)
  originalPrice      Decimal     @db.Decimal(12, 2)
  discountPercentage Int         @default(0)
  stock              Int         @default(0)
  inStock            Boolean     @default(true)
  fastDelivery       Boolean     @default(false)
  emiStartsAt        Decimal?    @db.Decimal(10, 2)
  model3D            Model3DType @default(CUSTOM)
  model3DUrl         String?     // External GLTF/GLB/USDZ asset path
  specifications     Json        @default("{}") // Structured technical specs
  rating             Decimal     @default(0.0) @db.Decimal(3, 2)
  reviewCount        Int         @default(0)
  isFeatured         Boolean     @default(false)
  isTrending         Boolean     @default(false)
  isActive           Boolean     @default(true)
  sellerId           String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relationships
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seller        User                 @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  colorVariants ProductColorVariant[]
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  flashDeals    FlashDeal[]
  bundleItems   ProductBundleItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([sellerId])
  @@index([price])
  @@index([rating])
  @@index([isFeatured, isTrending])
  @@index([brand])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  altText    String?
  isPrimary  Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductColorVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  hex       String
  inStock   Boolean  @default(true)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@map("product_color_variants")
}

// -----------------------------------------------------------------------------
// CUSTOMER ENGAGEMENT: REVIEWS, CART, WISHLIST
// -----------------------------------------------------------------------------

model Review {
  id               String   @id @default(cuid())
  userId           String
  productId        String
  rating           Int      @default(5)
  title            String
  comment          String   @db.Text
  verifiedPurchase Boolean  @default(false)
  helpfulCount     Int      @default(0)
  images           Json     @default("[]") // Array of customer photo URLs
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
  @@map("reviews")
}

model CartItem {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  quantity      Int      @default(1)
  selectedColor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, selectedColor])
  @@index([userId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  folder    String?  @default("Favorites")
  notes     String?
  addedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// -----------------------------------------------------------------------------
// ORDERS & FULFILLMENT
// -----------------------------------------------------------------------------

model Order {
  id                      String        @id @default(cuid())
  orderNumber             String        @unique // e.g. ORD-2026-8841
  userId                  String
  addressId               String?
  shippingAddressSnapshot Json          // Immutable address snapshot at checkout
  status                  OrderStatus   @default(ORDER_PLACED)
  paymentStatus           PaymentStatus @default(PENDING)
  paymentMethod           PaymentMethod @default(UPI)
  subtotal                Decimal       @db.Decimal(12, 2)
  discount                Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount               Decimal       @default(0.00) @db.Decimal(12, 2) // GST breakdown (CGST + SGST)
  deliveryFee             Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount             Decimal       @db.Decimal(12, 2)
  couponId                String?
  trackingNumber          String?       @unique
  carrier                 String?       @default("BlueDart Air Express")
  estimatedDelivery       DateTime?
  notes                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Relationships
  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  address  Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  coupon   Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  timeline OrderTimeline[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                     String   @id @default(cuid())
  orderId                String
  productId              String
  productName            String   // Snapshot for order immutability
  productSlug            String
  productImage           String?
  selectedColor          String?
  quantity               Int      @default(1)
  unitPrice              Decimal  @db.Decimal(12, 2)
  totalPrice             Decimal  @db.Decimal(12, 2)
  specificationsSnapshot Json     @default("{}")
  createdAt              DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderTimeline {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  description String
  location    String?
  completed   Boolean     @default(true)
  timestamp   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_timelines")
}

// -----------------------------------------------------------------------------
// PAYMENTS & FINANCIAL AUDIT
// -----------------------------------------------------------------------------

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  transactionId   String        @unique
  gatewayProvider String        @default("Razorpay") // Razorpay, Stripe, Cashfree, UPI
  gatewayOrderId  String?
  gatewayPaymentId String?
  paymentMethod   PaymentMethod @default(UPI)
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  gatewayFee      Decimal?      @db.Decimal(8, 2)
  gatewayResponse Json          @default("{}")
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@index([status])
  @@map("payments")
}

// -----------------------------------------------------------------------------
// PROMOTIONS, DEALS & BUNDLES
// -----------------------------------------------------------------------------

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  discount    Decimal    @db.Decimal(10, 2)
  type        CouponType @default(PERCENT)
  minOrder    Decimal    @default(0.00) @db.Decimal(12, 2)
  maxDiscount Decimal?   @db.Decimal(10, 2)
  validFrom   DateTime   @default(now())
  expiry      DateTime
  description String
  usageLimit  Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  orders Order[]

  @@index([code])
  @@index([isActive, expiry])
  @@map("coupons")
}

model FlashDeal {
  id                 String   @id @default(cuid())
  productId          String
  dealPrice          Decimal  @db.Decimal(12, 2)
  originalPrice      Decimal  @db.Decimal(12, 2)
  discountPercentage Int
  stockLeft          Int
  totalStock         Int
  startsAt           DateTime @default(now())
  endsAt             DateTime
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive, endsAt])
  @@map("flash_deals")
}

model ProductBundle {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  bundlePrice        Decimal  @db.Decimal(12, 2)
  regularPrice       Decimal  @db.Decimal(12, 2)
  discountPercentage Int      @default(10)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items ProductBundleItem[]

  @@map("product_bundles")
}

model ProductBundleItem {
  id        String   @id @default(cuid())
  bundleId  String
  productId String
  quantity  Int      @default(1)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  bundle  ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@index([productId])
  @@map("product_bundle_items")
}

// -----------------------------------------------------------------------------
// LOYALTY PROGRAM & REFERRALS
// -----------------------------------------------------------------------------

model UserReward {
  id            String       @id @default(cuid())
  userId        String       @unique
  pointsBalance Int          @default(0)
  tier          RewardTier   @default(SILVER)
  referralCode  String       @unique
  referralCount Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  history RewardTransaction[]

  @@index([userId])
  @@index([referralCode])
  @@map("user_rewards")
}

model RewardTransaction {
  id              String       @id @default(cuid())
  rewardAccountId String
  type            RewardTxType @default(EARNED)
  points          Int
  reason          String
  referenceId     String?      // Order ID or Referral User ID
  createdAt       DateTime     @default(now())

  account UserReward @relation(fields: [rewardAccountId], references: [id], onDelete: Cascade)

  @@index([rewardAccountId])
  @@index([type])
  @@map("reward_transactions")
}

// -----------------------------------------------------------------------------
// CUSTOMER SERVICE & TICKETING
// -----------------------------------------------------------------------------

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique // e.g. TKT-101
  userId       String
  orderId      String?
  category     TicketCategory @default(TECHNICAL_SUPPORT)
  subject      String
  description  String         @db.Text
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies SupportTicketReply[]

  @@index([ticketNumber])
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

model SupportTicketReply {
  id        String      @id @default(cuid())
  ticketId  String
  sender    ReplySender @default(USER)
  message   String      @db.Text
  createdAt DateTime    @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_replies")
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS & AUDIT LOGS
// -----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  adminName   String
  action      String
  resource    String
  details     Json     @default("{}")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  admin User? @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
