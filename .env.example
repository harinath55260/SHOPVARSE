# ==============================================================
# ShopVerse 3D — Production Environment Variables Reference
# ==============================================================

# Server Listening Port (Cloud Run automatically provides PORT, default: 3000)
PORT=3000

# Node Environment
NODE_ENV=production

# Google Gemini AI API Key (Optional: Server-side AI groceries advisor)
# If omitted, intelligent fallback heuristic engine seamlessly answers queries.
GEMINI_API_KEY=""

# Public Application URL (Optional: Cloud Run deployment URL)
APP_URL="https://shopverse-3d.run.app"

# Optional Database Connection String (PostgreSQL Prisma if used)
DATABASE_URL="postgresql://postgres:password@localhost:5432/shopverse3d?schema=public"
